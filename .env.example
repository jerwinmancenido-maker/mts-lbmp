DATABASE_URL="mysql://user:password@localhost:3306/mts_lbmp"
DIRECT_URL=
JWT_SECRET="replace-with-a-strong-secret"
NEXT_PUBLIC_API_URL="http://localhost:4100"
PORT=4100
# First-boot provisioning (Phase 5 P5-2): when the user store is empty, the
# API creates ONE initial System Admin from these values and flags it
# mustChangePassword, so the bootstrap secret below is single-use. Leave
# unset on any install that already has users; never commit real values.
MTS_BOOTSTRAP_EMAIL=
MTS_BOOTSTRAP_PASSWORD=
MTS_BOOTSTRAP_NAME=
# (end of file)
