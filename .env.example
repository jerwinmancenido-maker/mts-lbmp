# Database (CR-005: Supabase Postgres). DATABASE_URL goes through the
# transaction pooler; DIRECT_URL is the direct connection Prisma uses
# for migrations/schema work. Placeholder shapes only — real values live
# in the host's env panel, never in this file.
DATABASE_URL="postgresql://postgres.example-ref:example-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:example-password@db.example-ref.supabase.co:5432/postgres"
# Persistence backend: "json" (local file store) or "prisma" (Postgres).
# Defaults to "json" when unset — production MUST set this to prisma,
# otherwise the API silently runs on the local JSON file store.
MTS_REPOSITORY=
JWT_SECRET="replace-with-a-strong-secret"
# AUTH_SECRET is honoured as a fallback when JWT_SECRET is unset;
# either one satisfies the production boot check in security.ts.
AUTH_SECRET=
NEXT_PUBLIC_API_URL="http://localhost:4100"
PORT=4100
# Set to "production" on real deployments: with NODE_ENV=production the
# API refuses to boot unless JWT_SECRET or AUTH_SECRET is set.
NODE_ENV=
# First-boot provisioning (Phase 5 P5-2): when the user store is empty, the
# API creates ONE initial System Admin from these values and flags it
# mustChangePassword, so the bootstrap secret below is single-use. Leave
# unset on any install that already has users; never commit real values.
MTS_BOOTSTRAP_EMAIL=
MTS_BOOTSTRAP_PASSWORD=
MTS_BOOTSTRAP_NAME=
# Session token lifetimes (Phase 5 P5-5), in seconds, per login door.
# Defaults when unset: password door 43200 (12 h — an owner/admin working
# day), staff-code door 28800 (8 h — one warehouse shift). The legacy
# AUTH_TOKEN_TTL_SECONDS variable is still honoured as the password
# door's fallback when AUTH_PASSWORD_TOKEN_TTL_SECONDS is unset.
AUTH_PASSWORD_TOKEN_TTL_SECONDS=
AUTH_STAFF_CODE_TOKEN_TTL_SECONDS=
# CORS allow-list (Phase 5 P5-3): comma-separated web origins allowed to
# call the API with credentials, e.g.
# CORS_ORIGINS="https://app.example.com,capacitor://localhost"
# When unset, only local-dev origins are allowed (the Next.js dev server
# on http://localhost:3000 / http://127.0.0.1:3000 and the Capacitor
# shell). Production deployments MUST set this to the real web origin(s).
CORS_ORIGINS=
# (end of file)
