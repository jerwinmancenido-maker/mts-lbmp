DATABASE_URL="mysql://user:password@localhost:3306/mts_lbmp"
DIRECT_URL=
JWT_SECRET="replace-with-a-strong-secret"
NEXT_PUBLIC_API_URL="http://localhost:4100"
PORT=4100
# First-boot provisioning (Phase 5 P5-2): when the user store is empty, the
# API creates ONE initial System Admin from these values and flags it
# mustChangePassword, so the bootstrap secret below is single-use. Leave
# unset on any install that already has users; never commit real values.
MTS_BOOTSTRAP_EMAIL=
MTS_BOOTSTRAP_PASSWORD=
MTS_BOOTSTRAP_NAME=
# CORS allow-list (Phase 5 P5-3): comma-separated web origins allowed to
# call the API with credentials, e.g.
# CORS_ORIGINS="https://app.example.com,capacitor://localhost"
# When unset, only local-dev origins are allowed (the Next.js dev server
# on http://localhost:3000 / http://127.0.0.1:3000 and the Capacitor
# shell). Production deployments MUST set this to the real web origin(s).
CORS_ORIGINS=
# (end of file)
